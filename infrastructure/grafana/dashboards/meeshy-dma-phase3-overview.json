{
  "dashboard": {
    "id": null,
    "uid": "meeshy-dma-phase3",
    "title": "Meeshy Signal DMA - Phase 3 Production Overview",
    "tags": ["dma", "signal", "production", "phase3"],
    "timezone": "UTC",
    "schemaVersion": 35,
    "version": 0,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\"}",
          "name": "Firing Alerts",
          "step": "60s",
          "tagKeys": "severity,alertname"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Service Status",
        "type": "stat",
        "gridPos": {
          "h": 3,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"meeshy-dma-app\"}",
            "legendFormat": "Status",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "textMode": "auto",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                },
                "type": "value"
              }
            ],
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "Error Rate (%)",
        "type": "gauge",
        "gridPos": {
          "h": 3,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "dma:error_rate:1m",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        },
        "fieldConfig": {
          "defaults": {"unit": "percent", "min": 0, "max": 100}
        }
      },
      {
        "id": 3,
        "title": "API Latency P99 (ms)",
        "type": "gauge",
        "gridPos": {
          "h": 3,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "dma:http_request_duration:p99 * 1000",
            "legendFormat": "P99 Latency",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "red", "value": 500}
            ]
          }
        },
        "fieldConfig": {
          "defaults": {"unit": "ms", "min": 0, "max": 1000}
        }
      },
      {
        "id": 4,
        "title": "Active XMPP Connections",
        "type": "stat",
        "gridPos": {
          "h": 3,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "dma:xmpp_connections:active",
            "legendFormat": "Connections",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center",
          "orientation": "auto",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5000},
              {"color": "red", "value": 8000}
            ]
          }
        }
      },
      {
        "id": 5,
        "title": "Request Rate (req/sec)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 3
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m]))",
            "legendFormat": "Total Requests",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_requests_total{status=~\"2..\"}[1m]))",
            "legendFormat": "2xx Success",
            "refId": "B"
          },
          {
            "expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m]))",
            "legendFormat": "4xx Client Error",
            "refId": "C"
          },
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))",
            "legendFormat": "5xx Server Error",
            "refId": "D"
          }
        ],
        "options": {
          "legend": {"calcs": ["mean", "max"], "displayMode": "table"},
          "tooltip": {"mode": "multi"}
        }
      },
      {
        "id": 6,
        "title": "API Response Time Distribution",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 3
        },
        "targets": [
          {
            "expr": "dma:http_request_duration:p50 * 1000",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "dma:http_request_duration:p99 * 1000",
            "legendFormat": "P99",
            "refId": "B"
          },
          {
            "expr": "dma:http_request_duration:p999 * 1000",
            "legendFormat": "P99.9",
            "refId": "C"
          }
        ],
        "options": {
          "legend": {"calcs": ["mean", "max"], "displayMode": "table"},
          "tooltip": {"mode": "multi"}
        },
        "fieldConfig": {
          "defaults": {"unit": "ms"}
        }
      },
      {
        "id": 7,
        "title": "Message Throughput (msg/sec)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 11
        },
        "targets": [
          {
            "expr": "sum(rate(messages_sent_total[1m]))",
            "legendFormat": "Sent",
            "refId": "A"
          },
          {
            "expr": "sum(rate(messages_received_total[1m]))",
            "legendFormat": "Received",
            "refId": "B"
          },
          {
            "expr": "sum(rate(messages_encrypted_total[1m]))",
            "legendFormat": "Encrypted",
            "refId": "C"
          },
          {
            "expr": "sum(rate(messages_delivered_total[1m]))",
            "legendFormat": "Delivered",
            "refId": "D"
          }
        ],
        "options": {
          "legend": {"calcs": ["mean", "max", "min"], "displayMode": "table"},
          "tooltip": {"mode": "multi"}
        }
      },
      {
        "id": 8,
        "title": "Offline Queue Size",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 11
        },
        "targets": [
          {
            "expr": "meeshy_offline_messages_queue_size",
            "legendFormat": "Queue Size",
            "refId": "A"
          },
          {
            "expr": "meeshy_offline_messages_queue_size / 1000 * 100",
            "legendFormat": "Alert Threshold (10k)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"fillOpacity": 10},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10000},
                {"color": "red", "value": 100000}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Database Connections",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 19
        },
        "targets": [
          {
            "expr": "meeshy_db_connections_active",
            "legendFormat": "Active",
            "refId": "A"
          },
          {
            "expr": "meeshy_db_connections_max",
            "legendFormat": "Max",
            "refId": "B"
          }
        ]
      },
      {
        "id": 10,
        "title": "Message Encryption Latency (ms)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 19
        },
        "targets": [
          {
            "expr": "dma:encryption_latency:p99 * 1000",
            "legendFormat": "Encryption P99",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"calcs": ["mean", "max"], "displayMode": "table"}
        }
      },
      {
        "id": 11,
        "title": "System CPU Usage (%)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 27
        },
        "targets": [
          {
            "expr": "dma:cpu_usage:percentage",
            "legendFormat": "CPU Usage",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {"fillOpacity": 10},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 60},
                {"color": "red", "value": 80}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "System Memory Usage (%)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 27
        },
        "targets": [
          {
            "expr": "dma:memory_usage:percentage",
            "legendFormat": "Memory Usage",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {"fillOpacity": 10},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 85}
              ]
            }
          }
        }
      }
    ]
  }
}
